check("client shop shows server gold and closes",function()
    local c=context(); local p=makePlayer("A"); local gui=setupClient(c,p); c.net.Shop.OnClientEvent:Fire({open=true,gold=200}); equal(gui.Shop.Visible,true)
    for _,o in gui.Shop:GetChildren() do if o.ClassName=="TextButton" then o.MouseButton1Click:Fire() end end equal(gui.Shop.Visible,false)
end)
check("client sends item id when shop button is clicked",function()
    local c=context(); local p=makePlayer("A"); local gui=setupClient(c,p)
    for _,o in gui.Shop:GetDescendants() do if o.ClassName=="TextButton" and string.find(o.Text or "","Короткий меч",1,true) then o.MouseButton1Click:Fire() end end
    equal(#c.net.Buy.calls,1); equal(c.net.Buy.calls[1].args[1],"Sword")
end)
check("lost window focus releases held block",function()
    local c=context(); local p=makePlayer("A"); setupClient(c,p)
    services.UserInputService.InputBegan:Fire({UserInputType=Enum.UserInputType.MouseButton2},false); services.UserInputService.WindowFocusReleased:Fire()
    equal(c.net.Block.calls[#c.net.Block.calls].args[1],false,"Block remains held after focus loss")
end)
check("HUD displays gold outside shop",function()
    local c=context(); local p=makePlayer("A"); local gui=setupClient(c,p); c.net.Hud.OnClientEvent:Fire({gold=200})
    local found=false
    for _,o in gui.Panel:GetDescendants() do if o.ClassName=="TextLabel" and string.find(o.Text or "","200",1,true) then found=true end end
    assert(found,"Gold is not displayed in the persistent combat HUD")
end)
local function setupYard(c)
    local map=Instance.new("Folder"); map.Name="Map"; map.Parent=workspace
    local terrain=Instance.new("Terrain"); terrain.Name="Terrain"; terrain.Parent=workspace; terrain.fills={}
    function terrain:FillBlock(cf,size,material) table.insert(self.fills,{cf,size,material}) end
    factories["build-combat"]()
    c.world=loadModule("World"); c.world.init(c.config); c.world.attach(c)
    return map
end
check("yard builder and World wire all seven interaction points",function()
    local c=context(); local map=setupYard(c); equal(map.TrainingYard:GetAttribute("BuildComplete"),true)
    equal(#c.world.weaponPoints,4); equal(#c.world.prompts,7); equal(#map.TrainingYard.Targets:GetChildren(),3); assert(#c.world.trainingParts>0)
end)
check("yard builder replaces old yard without duplicating it",function()
    local c=context(); local map=setupYard(c); factories["build-combat"](); local count=0
    for _,o in map:GetChildren() do if o.Name=="TrainingYard" then count+=1 end end equal(count,1)
end)
check("weapon rack prompt equips weapon",function()
    local c=context(); setupYard(c); local p=makePlayer("A"); local rack=c.world.weaponPoints[1]
    rack:FindFirstChildOfClass("ProximityPrompt").Triggered:Fire(p); equal(c.stats.get(p).weapon,rack:GetAttribute("WeaponId"))
end)
check("armor rack prompt toggles armor on and off",function()
    local c=context(); setupYard(c); local p=makePlayer("A"); local prompt=c.world.armorPoint:FindFirstChildOfClass("ProximityPrompt")
    prompt.Triggered:Fire(p); equal(c.stats.get(p).armor.Helmet,true); prompt.Triggered:Fire(p); equal(c.stats.get(p).armor.Helmet,nil)
end)
check("vendor prompt sends shop-open packet",function()
    local c=context(); setupYard(c); local p=makePlayer("A"); c.world.vendorPoint:FindFirstChildOfClass("ProximityPrompt").Triggered:Fire(p)
    local last=c.net.Shop.calls[#c.net.Shop.calls]; equal(last.player,p); equal(last.args[1].open,true); equal(last.args[1].gold,200)
end)
local function setupFlight()
    local c=context(); local p,h,r=makePlayer("A"); services.Players.LocalPlayer=p; factories.ExplorerFlight(); advance(0)
    return c,p,h,r
end
check("flight starts disabled with speed 80",function()
    setupFlight(); equal(script:GetAttribute("Ready"),true); equal(script:GetAttribute("NoclipEnabled"),false); equal(script:GetAttribute("FlightSpeed"),80)
end)
check("Q enables flight and disables collisions",function()
    local _,_,h,r=setupFlight(); services.UserInputService.InputBegan:Fire({KeyCode=Enum.KeyCode.Q},false)
    equal(script:GetAttribute("NoclipEnabled"),true); equal(r.CanCollide,false); equal(h.PlatformStand,true); assert(r.ExplorerFlightVelocity)
end)
check("second Q restores collisions and character state",function()
    local _,_,h,r=setupFlight(); services.UserInputService.InputBegan:Fire({KeyCode=Enum.KeyCode.Q},false); services.UserInputService.InputBegan:Fire({KeyCode=Enum.KeyCode.Q},false)
    equal(r.CanCollide,true); equal(h.PlatformStand,false); equal(h.AutoRotate,true); equal(r.ExplorerFlightVelocity,nil)
end)
check("flight Q is ignored in text input and Roblox menu",function()
    setupFlight(); services.UserInputService.focused={}; services.UserInputService.InputBegan:Fire({KeyCode=Enum.KeyCode.Q},false); equal(script:GetAttribute("NoclipEnabled"),false)
    services.UserInputService.focused=nil; services.GuiService.MenuIsOpen=true; services.UserInputService.InputBegan:Fire({KeyCode=Enum.KeyCode.Q},false); equal(script:GetAttribute("NoclipEnabled"),false)
end)
check("flight wheel speed stays between 10 and 800",function()
    setupFlight(); services.UserInputService.InputBegan:Fire({KeyCode=Enum.KeyCode.Q},false)
    local wheel=services.ContextActionService.bindings.ExplorerFlightWheel
    wheel(nil,Enum.UserInputState.Change,{Position=Vector3.new(0,0,100)}); equal(script:GetAttribute("FlightSpeed"),800)
    wheel(nil,Enum.UserInputState.Change,{Position=Vector3.new(0,0,-100)}); equal(script:GetAttribute("FlightSpeed"),10)
end)
check("flight forward input follows camera direction",function()
    local _,_,_,r=setupFlight(); services.UserInputService.InputBegan:Fire({KeyCode=Enum.KeyCode.Q},false); services.UserInputService.keys[Enum.KeyCode.W]=true; services.RunService.PreSimulation:Fire()
    near(r.ExplorerFlightVelocity.VectorVelocity.Z,-80); near(r.ExplorerFlightVelocity.VectorVelocity.Magnitude,80)
end)
check("flight is disabled and collisions restored on death",function()
    local _,_,h,r=setupFlight(); services.UserInputService.InputBegan:Fire({KeyCode=Enum.KeyCode.Q},false); h.Health=0; h.Died:Fire()
    equal(script:GetAttribute("NoclipEnabled"),false); equal(r.CanCollide,true); equal(r.ExplorerFlightVelocity,nil)
end)
local pass,fail=0,0
check("vendor is an R6 character with face and six connected joints",function()
    local c=context(); setupYard(c); local model=c.world.vendorPoint.WeaponVendor
    assert(model and model:IsA("Model")); assert(model:FindFirstChildOfClass("Humanoid")); equal(model.PrimaryPart,model.HumanoidRootPart)
    for _,name in {"Head","Torso","Left Arm","Right Arm","Left Leg","Right Leg"} do assert(model:FindFirstChild(name),name) end
    assert(model.Head.face.Texture=="rbxasset://textures/face.png"); assert(model.LeatherApron); assert(model.MerchantCap)
    local motors=0
    for _,o in model:GetDescendants() do
        if o.ClassName=="Motor6D" then
            motors+=1
            near(((o.Part0.CFrame*o.C0).Position-(o.Part1.CFrame*o.C1).Position).Magnitude,0)
        end
    end
    equal(motors,6)
end)
check("vendor is static noncolliding and has limited label distance",function()
    local c=context(); setupYard(c); local model=c.world.vendorPoint.WeaponVendor; local anchored=0
    for _,o in model:GetDescendants() do
        if o:IsA("BasePart") then equal(o.CanCollide,false); equal(o.CanTouch,false); equal(o.CanQuery,false); equal(o.CastShadow,false); if o.Anchored then anchored+=1 end end
    end
    equal(anchored,1); equal(model.Humanoid.EvaluateStateMachine,false); equal(model.Head.VendorLabel.MaxDistance,70)
end)
check("vendor appearance installation is idempotent and removes old placeholder",function()
    local c=context(); local point=Instance.new("Part"); point.Position=Vector3.new(0,1,0)
    for _,name in {"Torso","Head","Hood"} do local o=Instance.new("Part"); o.Name=name; o.Parent=point end
    local oldLabel=Instance.new("BillboardGui"); oldLabel.Parent=point
    local first=c.vendor.ensure(point); local count=#first:GetDescendants(); equal(c.vendor.ensure(point),first); equal(#first:GetDescendants(),count)
    equal(point.Torso,nil); equal(point.Head,nil); equal(point.Hood,nil); equal(point:FindFirstChildOfClass("BillboardGui"),nil)
end)
check("flight does not rescan character descendants every frame",function()
    local _,p=setupFlight(); services.UserInputService.InputBegan:Fire({KeyCode=Enum.KeyCode.Q},false)
    local before=p.Character._descendantReads
    for i=1,100 do services.RunService.PreSimulation:Fire() end
    equal(p.Character._descendantReads,before)
end)
check("flight protects new parts and restores their original collision",function()
    local _,p=setupFlight(); services.UserInputService.InputBegan:Fire({KeyCode=Enum.KeyCode.Q},false)
    local gear=Instance.new("Part"); gear.Name="NewGear"; gear.Parent=p.Character; equal(gear.CanCollide,false)
    gear.CanCollide=true; equal(gear.CanCollide,false)
    services.UserInputService.InputBegan:Fire({KeyCode=Enum.KeyCode.Q},false); equal(gear.CanCollide,true)
    gear.CanCollide=false; gear.CanCollide=true; equal(gear.CanCollide,true)
end)
check("balanced map profile preserves geometry and colliders",function()
    local c=context(); local map=setupYard(c)
    local leaf=Instance.new("Part"); leaf.Name="Canopy"; leaf.Anchored=true; leaf.CanCollide=false; leaf.Parent=map
    local wall=Instance.new("Part"); wall.Name="Wall"; wall.Anchored=true; wall.Parent=map
    local count=#map:GetDescendants(); factories["optimize-map"]()
    equal(#map:GetDescendants(),count); equal(leaf.CastShadow,false); equal(leaf.CanQuery,false); equal(wall.CanCollide,true); equal(wall.CastShadow,true); equal(services.Lighting.GlobalShadows,true)
end)
check("map quality profiles are reversible across repeated applications",function()
    local c=context(); local map=setupYard(c)
    local leaf=Instance.new("Part"); leaf.Name="Canopy"; leaf.Anchored=true; leaf.CanCollide=false; leaf.Parent=map
    factories["optimize-map-low"](); equal(services.Lighting.GlobalShadows,false)
    factories["optimize-map"](); equal(services.Lighting.GlobalShadows,true)
    factories["optimize-map-low"](); factories["optimize-map-low"](); factories["optimize-map-restore"]()
    equal(services.Lighting.GlobalShadows,true); equal(leaf.CastShadow,true); equal(leaf.CanQuery,true); equal(leaf.CanTouch,true); equal(map:GetAttribute("PerformanceProfile"),nil)
end)
check("mounted sword parts retain their model offsets",function()
    local c=context(); local p=makePlayer("A"); c.arsenal.setWeapon(p,"Sword")
    local m=p.Character.Weapon_Sword
    near((m.Blade.Position-m.Grip.Position).Magnitude,1.9)
    near((m.Guard.Position-m.Grip.Position).Magnitude,.38)
end)
check("invalid weapon change preserves the equipped weapon",function()
    local c=context(); local p=makePlayer("A"); c.arsenal.setWeapon(p,"Sword")
    equal(c.arsenal.setWeapon(p,"Unknown"),false); equal(c.stats.get(p).weapon,"Sword"); assert(p.Character.Weapon_Sword)
end)
check("short stagger cancels melee even after its timer expires",function()
    local c=context(); local p=makePlayer("A"); local _,h=makePlayer("B",Vector3.new(0,0,-2))
    c.arsenal.setWeapon(p,"Sword"); c.melee.attack(p,"Right"); c.stats.setStagger(p,.05); advance(.3); equal(h.Health,100)
end)
check("weapon swap cancels an attack already in windup",function()
    local c=context(); local p=makePlayer("A"); local _,h=makePlayer("B",Vector3.new(0,0,-2))
    c.arsenal.setWeapon(p,"Sword"); c.melee.attack(p,"Right"); c.arsenal.setWeapon(p,"Axe"); advance(.3); equal(h.Health,100)
end)
check("queued block is not displayed as active while staggered",function()
    local c=context(); local p=makePlayer("A"); c.stats.setStagger(p,1); c.stats.setBlocking(p,true)
    equal(c.stats.hudFor(p).blocking,false); advance(1.01); equal(c.stats.hudFor(p).blocking,true)
end)
check("unchanged HUD is not broadcast repeatedly",function()
    local c=context(); local p=makePlayer("A"); c.stats.get(p); c.stats.broadcast()
    local n=#c.net.Hud.calls; c.stats.broadcast(); equal(#c.net.Hud.calls,n)
    c.stats.spend(p,1); c.stats.broadcast(); equal(#c.net.Hud.calls,n+1)
end)
check("focus loss cancels bow draw without releasing an arrow",function()
    local c=context(); local p=makePlayer("A"); setupClient(c,p); c.net.Hud.OnClientEvent:Fire({weaponKind="Bow"})
    services.UserInputService.InputBegan:Fire({UserInputType=Enum.UserInputType.MouseButton1},false)
    services.UserInputService.WindowFocusReleased:Fire()
    equal(#c.net.Release.calls,0); equal(c.net.DrawStart.calls[#c.net.DrawStart.calls].args[1],false)
end)
check("NaN bow aim cannot create a projectile",function()
    local c=context(); local p=makePlayer("A"); c.arsenal.setWeapon(p,"Bow"); c.arrows.drawStart(p); advance(.6)
    c.arrows.release(p,Vector3.new(0/0,0,0)); equal(c.arrows.count(),0); near(c.stats.get(p).stamina,100)
end)
check("merchant reuse repairs Humanoid torso collision defaults",function()
    local c=context(); setupYard(c); local model=c.world.vendorPoint.WeaponVendor
    model.Torso.CanCollide=true
    equal(c.vendor.ensure(c.world.vendorPoint),model); equal(model.Torso.CanCollide,false)
end)
for _,r in results do if r.passed then pass+=1 else fail+=1 end end
print(string.format("SUMMARY\t%d\t%d\t%d",#results,pass,fail))
