-- Behavior assertions against unmodified production modules.
check("new combat state has full stamina",function()
    local c=context(); local p=makePlayer("A"); equal(c.stats.get(p).stamina,100)
end)
check("stamina spending and insufficient-stamina rejection",function()
    local c=context(); local p=makePlayer("A"); equal(c.stats.spend(p,12),true); equal(c.stats.get(p).stamina,88)
    equal(c.stats.spend(p,90),false); equal(c.stats.get(p).stamina,88)
end)
check("stamina regeneration respects delay and maximum",function()
    local c=context(); local p=makePlayer("A"); c.stats.spend(p,20); advance(0.6); equal(c.stats.get(p).stamina,80)
    advance(0.21); near(c.stats.get(p).stamina,83.2); advance(3); equal(c.stats.get(p).stamina,100)
end)
check("gold cannot become negative",function()
    local c=context(); local p=makePlayer("A"); c.stats.setGold(p,-5); equal(c.stats.getGold(p),0)
end)
check("normal sword purchase equips and charges 40",function()
    local c=context(); local p=makePlayer("A"); c.shop.buy(p,"Sword"); equal(c.stats.getGold(p),160); equal(c.stats.get(p).weapon,"Sword"); assert(p.Character.Weapon_Sword)
end)
check("purchase rejected when gold is insufficient",function()
    local c=context(); local p=makePlayer("A"); c.stats.setGold(p,5); c.shop.buy(p,"Axe"); equal(c.stats.getGold(p),5); equal(c.stats.get(p).weapon,nil)
end)
check("unknown shop item changes neither gold nor equipment",function()
    local c=context(); local p=makePlayer("A"); c.shop.buy(p,"Exploit"); equal(c.stats.getGold(p),200); equal(c.stats.get(p).weapon,nil)
end)
check("non-string purchase is rejected",function()
    local c=context(); local p=makePlayer("A"); c.shop.buy(p,{}); equal(c.stats.getGold(p),200)
end)
check("dead character cannot buy equipment",function()
    local c=context(); local p,h=makePlayer("A"); h.Health=0; c.shop.buy(p,"Sword"); equal(c.stats.getGold(p),200); equal(c.stats.get(p).weapon,nil)
end)
check("failed equipment delivery does not charge gold",function()
    local c=context(); local p=makePlayer("A"); p.Character.RightHand:Destroy(); c.shop.buy(p,"Sword"); equal(c.stats.getGold(p),200); equal(c.stats.get(p).weapon,nil)
end)
check("purchase requires proximity to the vendor",function()
    local c=context(); local p=makePlayer("A",Vector3.new(10000,0,10000))
    c.world.vendorPoint=Instance.new("Part"); c.world.vendorPoint.Position=Vector3.zero
    c.shop.buy(p,"Sword"); equal(c.stats.getGold(p),200,"Remote purchase far from vendor must be rejected")
end)
check("shield survives switching main weapon",function()
    local c=context(); local p=makePlayer("A"); assert(c.arsenal.setShield(p,true)); assert(c.arsenal.setWeapon(p,"Sword"))
    equal(c.stats.get(p).shield,true); assert(p.Character.Weapon_Shield,"Shield model was removed by weapon switch")
end)
check("armor equips and removes",function()
    local c=context(); local p=makePlayer("A"); c.arsenal.wearAll(p); equal(c.stats.get(p).armor.Helmet,true); assert(p.Character.Armor_Cuirass)
    c.arsenal.stripAll(p); equal(c.stats.get(p).armor.Helmet,nil); equal(p.Character.Armor_Cuirass,nil)
end)
check("full armor gives 38.224 percent reduction",function()
    local c=context(); local p=makePlayer("A"); c.arsenal.wearAll(p); near(c.arsenal.reduction(p),0.38224)
end)
check("damage applies armor reduction and rounding",function()
    local c=context(); local p,h=makePlayer("A"); c.arsenal.wearAll(p); equal(c.stats.damage(p,26,nil,"sword",0),16); equal(h.Health,84)
end)
check("stab armor penetration increases damage",function()
    local c=context(); local p=makePlayer("A"); c.arsenal.wearAll(p); equal(c.stats.damage(p,26*1.15,nil,"stab",0.5),24)
end)
check("frontal block prevents damage and costs stamina",function()
    local c=context(); local p,h=makePlayer("A"); local a=makePlayer("B",Vector3.new(0,0,-3)); c.stats.setBlocking(p,true)
    equal(c.stats.damage(p,26,a,"sword",0),0); equal(h.Health,100); equal(c.stats.get(p).stamina,90)
end)
check("attack from behind bypasses block",function()
    local c=context(); local p,h=makePlayer("A"); local a=makePlayer("B",Vector3.new(0,0,3)); c.stats.setBlocking(p,true)
    equal(c.stats.damage(p,26,a,"sword",0),26); equal(h.Health,74)
end)
check("shield block costs six stamina",function()
    local c=context(); local p=makePlayer("A"); local a=makePlayer("B",Vector3.new(0,0,-3)); c.stats.get(p).shield=true; c.stats.setBlocking(p,true)
    c.stats.damage(p,26,a,"sword",0); equal(c.stats.get(p).stamina,94)
end)
check("guard break staggers and cannot immediately block again",function()
    local c=context(); local p=makePlayer("A"); local a=makePlayer("B",Vector3.new(0,0,-3)); c.stats.spend(p,95); c.stats.setBlocking(p,true)
    equal(c.stats.damage(p,26,a,"sword",0),26); equal(c.stats.canAct(p,clock),false)
    advance(1.01); equal(c.stats.canAct(p,clock),false); c.stats.setBlocking(p,true)
    assert(c.stats.damage(p,26,a,"sword",0)>0,"Target blocked while still staggered")
end)
check("blocking speed is restored correctly after stagger",function()
    local c=context(); local p,h=makePlayer("A"); c.stats.setStagger(p,1); c.stats.setBlocking(p,true); advance(1.01)
    near(h.WalkSpeed,c.config.Movement.Walk*c.config.Block.MoveMultiplier,1e-6,"Held block must retain its movement penalty")
end)
check("unarmed melee request causes no damage",function()
    local c=context(); local p=makePlayer("A"); local _,h=makePlayer("B",Vector3.new(0,0,-2)); c.melee.attack(p,"Right"); advance(0.5); equal(h.Health,100)
end)
check("valid sword attack hits a nearby frontal target",function()
    local c=context(); local p=makePlayer("A"); local _,h=makePlayer("B",Vector3.new(0,0,-2)); c.arsenal.setWeapon(p,"Sword"); c.melee.attack(p,"Right"); advance(0.3)
    assert(h.Health<100 and h.Health>70); near(c.stats.get(p).stamina,88)
end)
check("melee cooldown prevents repeated damage",function()
    local c=context(); local p=makePlayer("A"); local _,h=makePlayer("B",Vector3.new(0,0,-2)); c.arsenal.setWeapon(p,"Sword"); c.melee.attack(p,"Right"); c.melee.attack(p,"Right"); advance(0.3)
    equal(h.Health,76); near(c.stats.get(p).stamina,88)
end)
check("melee range rejects distant target",function()
    local c=context(); local p=makePlayer("A"); local _,h=makePlayer("B",Vector3.new(0,0,-20)); c.arsenal.setWeapon(p,"Sword"); c.melee.attack(p,"Right"); advance(0.3); equal(h.Health,100)
end)
check("melee arc rejects target behind attacker",function()
    local c=context(); local p=makePlayer("A"); local _,h=makePlayer("B",Vector3.new(0,0,2)); c.arsenal.setWeapon(p,"Sword"); c.melee.attack(p,"Right"); advance(0.3); equal(h.Health,100)
end)
check("melee line-of-sight obstruction prevents damage",function()
    local c=context(); local p=makePlayer("A"); local _,h=makePlayer("B",Vector3.new(0,0,-2)); workspace.raycastResult={Instance=Instance.new("Part")}; c.arsenal.setWeapon(p,"Sword"); c.melee.attack(p,"Right"); advance(0.3); equal(h.Health,100)
end)
check("staggered attacker cannot start melee attack",function()
    local c=context(); local p=makePlayer("A"); local _,h=makePlayer("B",Vector3.new(0,0,-2)); c.arsenal.setWeapon(p,"Sword"); c.stats.setStagger(p,1); c.melee.attack(p,"Right"); advance(0.3); equal(h.Health,100)
end)
check("stagger during windup cancels pending melee damage",function()
    local c=context(); local p=makePlayer("A"); local _,h=makePlayer("B",Vector3.new(0,0,-2)); c.arsenal.setWeapon(p,"Sword"); c.melee.attack(p,"Right"); c.stats.setStagger(p,1); advance(0.3); equal(h.Health,100,"Pending attack must not land through stagger")
end)
check("training melee awards two gold",function()
    local c=context(); local p=makePlayer("A"); c.arsenal.setWeapon(p,"Sword"); local dummy=Instance.new("Part"); dummy.Position=Vector3.new(0,0,-2); c.world.trainingParts={dummy}
    c.melee.attack(p,"Right"); advance(0.3); equal(c.stats.getGold(p),202)
end)
check("bow release without drawing is rejected",function()
    local c=context(); local p=makePlayer("A"); c.arsenal.setWeapon(p,"Bow"); c.arrows.release(p,Vector3.new(0,0,-1)); equal(c.arrows.count(),0)
end)
check("bow draw shorter than minimum is rejected",function()
    local c=context(); local p=makePlayer("A"); c.arsenal.setWeapon(p,"Bow"); c.arrows.drawStart(p); advance(0.2); c.arrows.release(p,Vector3.new(0,0,-1)); equal(c.arrows.count(),0)
end)
check("full bow draw creates projectile and spends six stamina",function()
    local c=context(); local p=makePlayer("A"); c.arsenal.setWeapon(p,"Bow"); c.arrows.drawStart(p); advance(1.21); c.arrows.release(p,Vector3.new(0,0,-1)); equal(c.arrows.count(),1); near(c.stats.get(p).stamina,94)
    local arrow=workspace:FindFirstChild("Arrow"); assert(arrow); near(arrow.AssemblyLinearVelocity.Magnitude,175)
end)
check("starting bow draw cancels blocking",function()
    local c=context(); local p=makePlayer("A"); c.arsenal.setWeapon(p,"Bow"); c.stats.setBlocking(p,true); c.arrows.drawStart(p); equal(c.stats.get(p).blocking,false)
end)
check("stagger prevents starting bow draw",function()
    local c=context(); local p=makePlayer("A"); c.arsenal.setWeapon(p,"Bow"); c.stats.setStagger(p,2); c.arrows.drawStart(p); equal(c.stats.get(p).drawStarted,0)
end)
check("stagger prevents releasing an already drawn bow",function()
    local c=context(); local p=makePlayer("A"); c.arsenal.setWeapon(p,"Bow"); c.arrows.drawStart(p); advance(0.5); c.stats.setStagger(p,2); c.arrows.release(p,Vector3.new(0,0,-1)); equal(c.arrows.count(),0,"Staggered character fired an arrow")
end)
check("dead character cannot release drawn bow",function()
    local c=context(); local p,h=makePlayer("A"); c.arsenal.setWeapon(p,"Bow"); c.arrows.drawStart(p); advance(0.5); h.Health=0; c.arrows.release(p,Vector3.new(0,0,-1)); equal(c.arrows.count(),0,"Dead character fired an arrow")
end)
check("non-finite bow aim is rejected",function()
    local c=context(); local p=makePlayer("A"); c.arsenal.setWeapon(p,"Bow"); c.arrows.drawStart(p); advance(0.5); c.arrows.release(p,Vector3.new(math.huge,0,0)); equal(c.arrows.count(),0,"Infinite aim produced an invalid projectile")
end)
check("expired arrow is removed",function()
    local c=context(); local p=makePlayer("A"); c.arsenal.setWeapon(p,"Bow"); c.arrows.drawStart(p); advance(0.5); c.arrows.release(p,Vector3.new(0,0,-1)); advance(6.1); equal(c.arrows.count(),0)
end)
check("arrow impact damages another player",function()
    local c=context(); local p=makePlayer("A"); local other,h=makePlayer("B",Vector3.new(0,0,-5)); c.arsenal.setWeapon(p,"Bow"); c.arrows.drawStart(p); advance(1.21); c.arrows.release(p,Vector3.new(0,0,-1))
    workspace.raycastResult={Instance=other.Character.Head}; advance(0.05); equal(h.Health,60)
end)
check("arrow hit on training target awards two gold",function()
    local c=context(); local p=makePlayer("A"); local target=Instance.new("Part"); target.Parent=workspace; c.world.trainingParts={target}; c.arsenal.setWeapon(p,"Bow"); c.arrows.drawStart(p); advance(1.21); c.arrows.release(p,Vector3.new(0,0,-1))
    workspace.raycastResult={Instance=target}; advance(0.05); equal(c.stats.getGold(p),202,"Archery training did not reward a hit")
end)
check("combat remotes are created once and found by client",function()
    context(); local net=loadModule("CombatNet"); local one=net.server(); local two=net.server(); local client=net.client()
    equal(#services.ReplicatedStorage.CombatRemotes:GetChildren(),8); equal(one.Attack,two.Attack); equal(client.Buy,one.Buy)
end)
check("client starts and builds HUD and eight shop buttons",function()
    local c=context(); local p=makePlayer("A"); local gui=setupClient(c,p); assert(gui.Panel); assert(gui.Shop); local count=0
    for _,o in gui.Shop:GetDescendants() do if o.ClassName=="TextButton" then count+=1 end end equal(count,9)
end)
check("client left mouse sends melee attack",function()
    local c=context(); local p=makePlayer("A"); setupClient(c,p); services.UserInputService.InputBegan:Fire({UserInputType=Enum.UserInputType.MouseButton1},false); equal(#c.net.Attack.calls,1)
end)
check("client text focus suppresses combat input",function()
    local c=context(); local p=makePlayer("A"); setupClient(c,p); services.UserInputService.focused={}; services.UserInputService.InputBegan:Fire({UserInputType=Enum.UserInputType.MouseButton1},false); equal(#c.net.Attack.calls,0)
end)
check("client bow click and release send correct requests",function()
    local c=context(); local p=makePlayer("A"); local gui=setupClient(c,p); c.net.Hud.OnClientEvent:Fire({weaponKind="Bow"})
    services.UserInputService.InputBegan:Fire({UserInputType=Enum.UserInputType.MouseButton1},false); equal(#c.net.DrawStart.calls,1); equal(gui.DrawBack.Visible,true)
    services.UserInputService.InputEnded:Fire({UserInputType=Enum.UserInputType.MouseButton1}); equal(#c.net.Release.calls,1); equal(gui.DrawBack.Visible,false)
