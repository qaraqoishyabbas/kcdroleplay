do
local parent=ServerScriptService
parent=ensure(parent,"Combat","Folder")
local obj=ensure(parent,"World","ModuleScript")
local source=[[-- Finds the training yard built by build-combat.luau and wires its interaction points.
local World = {}

function World.init(config)
	local map = workspace:FindFirstChild("Map")
	assert(map, "Map missing: run build-map.luau first")
	local yard = map:FindFirstChild(config.ModelName)
	assert(yard, "TrainingYard missing: run build-combat.luau")
	World.yard = yard
	World.weaponPoints = {}
	World.shieldPoint = nil
	World.armorPoint = nil
	World.vendorPoint = nil
	World.trainingParts = {}
	for _, item in yard:GetDescendants() do
		if item:IsA("BasePart") then
			local point = item:GetAttribute("CombatPoint")
			if point == "Weapon" then
				table.insert(World.weaponPoints, item)
			elseif point == "Shield" then
				World.shieldPoint = item
			elseif point == "Armor" then
				World.armorPoint = item
			elseif point == "Vendor" then
				World.vendorPoint = item
			end
			local parentName = item.Parent and item.Parent.Name or ""
			if string.sub(parentName, 1, 6) == "Target" or string.sub(parentName, 1, 5) == "Dummy" or parentName == "Targets" then
				table.insert(World.trainingParts, item)
			end
		end
	end
	return World
end

local function makePrompt(part, action, object, distance)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = object
	prompt.HoldDuration = 0.15
	prompt.MaxActivationDistance = distance or 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = part
	return prompt
end

function World.attach(ctx)
	World.prompts = {}

	if World.vendorPoint then
		ctx.vendor.ensure(World.vendorPoint)
		local prompt = makePrompt(World.vendorPoint, "Торговать", "Оружейник", 12)
		prompt.Triggered:Connect(function(player)
			ctx.shop.open(player)
		end)
		table.insert(World.prompts, prompt)
	end

	for _, part in World.weaponPoints do
		local weaponId = part:GetAttribute("WeaponId")
		local definition = ctx.arsenal.weaponDefinition(weaponId)
		if definition then
			ctx.arsenal.spawnDisplay(part, weaponId)
			local prompt = makePrompt(part, "Взять", definition.Name)
			prompt.Triggered:Connect(function(player)
				if ctx.arsenal.setWeapon(player, weaponId) then
					ctx.net.Notice:FireClient(player, { text = "Взяла: " .. definition.Name, kind = "good" })
				end
			end)
			table.insert(World.prompts, prompt)
		end
	end

	if World.shieldPoint then
		ctx.arsenal.spawnDisplay(World.shieldPoint, "Shield")
		local prompt = makePrompt(World.shieldPoint, "Взять щит", "Стойка со щитами")
		prompt.Triggered:Connect(function(player)
			local state = ctx.stats.get(player)
			local had = state.shield
			ctx.arsenal.setShield(player, not had)
			ctx.net.Notice:FireClient(player, { text = had and "Щит убран" or "Щит взят", kind = "good" })
		end)
		table.insert(World.prompts, prompt)
	end

	if World.armorPoint then
		ctx.arsenal.spawnArmorDisplay(World.armorPoint)
		local prompt = makePrompt(World.armorPoint, "Надеть броню", "Стойка с бронёй")
		prompt.Triggered:Connect(function(player)
			local state = ctx.stats.get(player)
			local wearing = false
			for _, piece in ctx.config.Armor do
				if state.armor[piece.Id] then
					wearing = true
					break
				end
			end
			if wearing then
				ctx.arsenal.stripAll(player)
				ctx.net.Notice:FireClient(player, { text = "Броня снята", kind = "info" })
			else
				ctx.arsenal.wearAll(player)
				ctx.net.Notice:FireClient(player, { text = "Броня надета", kind = "good" })
			end
		end)
		table.insert(World.prompts, prompt)
	end
end

return World
]]
editor:UpdateSourceAsync(obj,function() return source end)
end
do
local parent=ServerScriptService
local obj=ensure(parent,"CombatBootstrap","Script")
obj.Enabled=false
local source=[[-- Server entry point for medieval combat. Requires the training yard from build-combat.luau.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage:WaitForChild("CombatConfig"))
local Net = require(ReplicatedStorage:WaitForChild("CombatNet"))

local folder = ServerScriptService:WaitForChild("Combat")
local World = require(folder.World)
local Arsenal = require(folder.Arsenal)
local Stats = require(folder.Stats)
local Melee = require(folder.Melee)
local Arrows = require(folder.Arrows)
local Shop = require(folder.Shop)
local Vendor = require(folder.Vendor)

local net = Net.server()
World.init(Config)

local ctx = {
	config = Config,
	net = net,
	world = World,
	arsenal = Arsenal,
	stats = Stats,
	melee = Melee,
	arrows = Arrows,
	shop = Shop,
	vendor = Vendor,
}

Arsenal.init(ctx)
Stats.init(ctx)
Melee.init(ctx)
Arrows.init(ctx)
Shop.init(ctx)
World.attach(ctx)

Players.RespawnTime = Config.Player.RespawnTime

local function onCharacter(player, character)
	Stats.reset(player)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if humanoid then
		humanoid.MaxHealth = Config.Player.MaxHealth
		humanoid.Health = humanoid.MaxHealth
		humanoid.WalkSpeed = Config.Movement.Walk
	end
	Arsenal.reapply(player)
	net.Hud:FireClient(player, Stats.hudFor(player))
end

local function onPlayer(player)
	Stats.get(player)
	if player:GetAttribute("Gold") == nil then
		player:SetAttribute("Gold", Config.Player.StartGold)
	end
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	if player.Character then
		onCharacter(player, player.Character)
	end
end

Players.PlayerAdded:Connect(onPlayer)
for _, player in Players:GetPlayers() do
	onPlayer(player)
end

net.Attack.OnServerEvent:Connect(function(player, direction)
	if type(direction) ~= "string" then
		return
	end
	Melee.attack(player, direction)
end)

net.Block.OnServerEvent:Connect(function(player, on)
	Stats.setBlocking(player, on == true)
end)

net.DrawStart.OnServerEvent:Connect(function(player, active)
	if active == false then Stats.get(player).drawStarted = 0 return end
	Arrows.drawStart(player)
end)

net.Release.OnServerEvent:Connect(function(player, aim)
	if aim ~= nil and typeof(aim) ~= "Vector3" then
		return
	end
	Arrows.release(player, aim)
end)

net.Buy.OnServerEvent:Connect(function(player, itemId)
	if type(itemId) ~= "string" or #itemId > 24 then
		return
	end
	Shop.buy(player, itemId)
end)

task.spawn(function()
	while true do
		task.wait(0.5)
		Stats.broadcast()
	end
end)

print("COMBAT_READY", Config.Version)
]]
editor:UpdateSourceAsync(obj,function() return source end)
obj.Enabled=true
end
do
